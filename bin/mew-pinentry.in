#!/bin/sh
#
# mew-pinentry:: a simple pinentry
#
# Author:  Mew developing team
# Created: Jul 24, 2006
# Revised: Oct 24, 2026

PROMPT="Enter passphrase:"
TTY=`tty`

# Assuan data lines must escape "%" (a line read from the tty has no LF).
encode () {
	rest=$1 enc=
	while :; do
		case $rest in
		*%*)	enc=$enc${rest%%\%*}%25
			rest=${rest#*\%} ;;
		*)	enc=$enc$rest
			break ;;
		esac
	done
}

echo "OK"
while read -r cmd arg; do
	case $cmd in
	"OPTION")
		key=${arg%%=*}
		val=${arg#*=}
		if [ "X$key" = "Xttyname" ]; then
			TTY=$val
		fi
		;;
#	"SETPROMPT")
#		PROMPT=$arg
#		;;
	"GETPIN")
		echo @ECHO_N@ "$PROMPT @ECHO_C@" > "$TTY"
		stty -echo  < "$TTY"
		IFS= read -r passwd < "$TTY"
		ok=$?
		stty  echo  < "$TTY"
		echo "" > "$TTY"
		if [ $ok -ne 0 ]; then
			echo "ERR 83886179 Operation cancelled"
			continue
		fi
		encode "$passwd"
		printf 'D %s\n' "$enc"
		;;
	"BYE")
#		echo "OK"
		exit 0
		;;
	"SETERROR")
		printf '%s\n' "$arg" > "$TTY"
		;;
	esac
	echo "OK"
done
exit 0

